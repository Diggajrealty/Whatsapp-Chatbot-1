GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here
ADMIN_PHONE_NUMBER=919876543210

# Key Luna (CRM) must send in the x-api-key header. Leave blank to disable auth.
CRM_API_KEY=pick_a_long_random_string

# Where Kaira POSTs back to Luna when a site visit is booked. Unset = log only.
CRM_WEBHOOK_URL=https://your-crm/webhooks/kaira
